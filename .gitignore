node_modules/
.DS_Store

# Projekt-Dateien = Inhalt (spaeter Google Drive), nicht ins Repo.
projects/

# Rechnerlokale Einmal-Helfer und ihre Ergebnisdateien, nicht committen.
Claude-Login.cmd
Diagnose.cmd
*-ergebnis.txt

# Zugaenge: nie committen.
.env
.env.*
!.env.example
*.key
*.pem
*.crt
credentials.json
*service-account*.json

# OAuth-Tokens: lokal, nie im Repo.
data/tokens.json

# Diagnose-Log der Drive-Anbindung (lokal, nicht versionieren)
data/drive-error.log

# gdrive-Zugangsdaten-Cache (Token, lokal, nie versionieren)
data/.gdrive-env.json

# gdrive-Struktur-Cache fuer die Selbstheilung (client_id, kein Token/Secret) — lokal
data/.gdrive-struktur.json

# Spalten-Cache (v17b): Drive ist Wahrheit, data/spalten.json regeneriert lokal — nicht committen
data/spalten.json

# Board-Cache (v41): ab v17 ist board.json nur der schnelle Cache, die Wahrheit liegt in Drive
# ((AI only)/projekt.json je Karte). Regeneriert lokal beim Abgleich — Daten erst da, wenn Drive
# verbunden ist. Nicht committen.
data/board.json

# Redaktionsplan-Cache (v48): data/plan.json ist ab v17d nur der Cache, Drive ist Wahrheit
# (System (AI only)/redaktionsplan.json). Fehlt der Cache, greift pipeline.defaultPlan(). Nicht committen.
data/plan.json

# Selbstsigniertes HTTPS-Zertifikat: wird beim Start erzeugt, rechnerlokal
data/localhost.key
data/localhost.crt
