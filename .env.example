# Meta (Instagram API mit Instagram-Login — KEIN Facebook-Login noetig)
# App anlegen: https://developers.facebook.com → Create App
# Produkt hinzufuegen: Instagram → Instagram API mit Instagram-Login
# Redirect URI eintragen: https://localhost:4321/api/auth/instagram/callback
# Instagram-App-ID und -Secret stehen unter: App-Einstellungen → Allgemeines
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn
# App anlegen: https://www.linkedin.com/developers → Create app
# Redirect URI eintragen: https://localhost:4321/api/auth/linkedin/callback
# Berechtigungen (Products): Community Management API beantragen
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Web-Suche der Recherche-Rolle (v40) — OPTIONAL.
# Ohne Key laeuft die Recherche schluessellos ueber DuckDuckGo (null Setup, drosselt aber bei Last).
# Fuer stabilere Ergebnisse: Gratis-Key bei https://tavily.com holen (1000 Suchen/Monat, keine Karte)
# und hier eintragen. Nichts installieren, nichts starten.
TAVILY_API_KEY=

# Google Kalender + Tasks (Drehtermine als Termin + Aufgabe) — ODER im Board: Einrichtung Schritt 2
# console.cloud.google.com → APIs „Google Calendar API" + „Google Tasks API" aktivieren
# → Credentials → OAuth client ID (Web application)
# Redirect URI eintragen: https://localhost:4321/api/auth/google/callback
# Fuer Dauerbetrieb die OAuth-App auf „In production" stellen (im Modus „Testing" laeuft die Anmeldung nach 7 Tagen ab).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
