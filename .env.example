# Meta (Instagram Graph API)
# App anlegen: https://developers.facebook.com → Create App → Business
# Redirect URI eintragen: http://localhost:4321/api/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn
# App anlegen: https://www.linkedin.com/developers → Create app
# Redirect URI eintragen: http://localhost:4321/api/auth/linkedin/callback
# Berechtigungen: r_organization_social, rw_organization_admin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
